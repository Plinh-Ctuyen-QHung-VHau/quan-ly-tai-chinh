PORT=3006
NODE_ENV=development

# Supabase credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=finance
EVENT_LOG_SCHEMA=app_common
PROCESSED_EVENTS_SCHEMA=app_common

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=8000
GEMINI_FORMAT_RESPONSE=false

# Service URLs for Docker environment
API_GATEWAY_URL=http://api-gateway:3000
TRANSACTION_SERVICE_URL=http://transaction-service:3002
BUDGET_NOTIFICATION_SERVICE_URL=http://budget-notification-service:3004
MESSAGE_BROKER_URL=

# Anomaly thresholds
ANOMALY_AMOUNT_THRESHOLD=5000000
DAILY_SPIKE_MULTIPLIER=2.5
FREQUENCY_MULTIPLIER=2

CONSUMER_NAME=finance-intelligence-service

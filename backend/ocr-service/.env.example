# Service Port
PORT=3003

# PostgreSQL Database Connection URL
# Example: postgresql://postgres:your_password@db.project_ref.supabase.co:5432/postgres
DATABASE_URL=

# Supabase credentials for storage access
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
SUPABASE_DB_SCHEMA=ocr

# OCR Engine Configuration
# Use 'tesseract' for the real engine or 'mock' for testing.
OCR_ENGINE=tesseract
# Languages for Tesseract to use, separated by '+'
OCR_LANG=vie+eng
# Timeout for the entire OCR process in milliseconds
OCR_TIMEOUT_MS=60000

# Image Preprocessing Configuration
# Enable or disable image preprocessing before OCR
OCR_PREPROCESS_ENABLED=true
# Maximum width to resize large images to.
OCR_MAX_IMAGE_WIDTH=1600
